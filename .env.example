# Database owned by the personal Task Dash deployment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Google OAuth app owned by willfarparan@gmail.com.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate a dedicated random value; do not reuse an OAuth secret in production.
DASHBOARD_SESSION_SECRET=

# Optional assistant integration.
ANTHROPIC_API_KEY=

# Optional future Adobe Microsoft inbox integration.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
